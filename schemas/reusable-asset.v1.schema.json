{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://praxis.local/schemas/reusable-asset.v1.schema.json",
  "title": "Praxis reusable asset v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "version",
    "revision",
    "status",
    "body",
    "derivedFrom",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "kind": {
      "enum": [
        "rule",
        "skill",
        "workflow",
        "agent-policy",
        "summary",
        "pattern"
      ]
    },
    "version": { "type": "string", "minLength": 1 },
    "revision": { "type": "integer", "minimum": 1 },
    "status": {
      "enum": [
        "draft",
        "candidate",
        "validated",
        "active",
        "challenged",
        "deprecated"
      ]
    },
    "body": {},
    "derivedFrom": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/evidenceRef" }
    },
    "forkedFrom": { "$ref": "#/$defs/assetRef" },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "assetRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "revision"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "revision": { "type": "integer", "minimum": 1 }
      }
    },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin"],
      "properties": {
        "eventId": { "type": "string", "minLength": 1 },
        "assetId": { "type": "string", "minLength": 1 },
        "artifactHash": { "type": "string", "minLength": 1 },
        "origin": {
          "enum": ["direct", "declared", "inferred", "institutional"]
        },
        "exposureInfluenced": { "type": "boolean" }
      },
      "anyOf": [
        { "required": ["eventId"] },
        { "required": ["assetId"] },
        { "required": ["artifactHash"] }
      ]
    }
  }
}
