{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://praxis-runtime.local/schemas/expectation-registered-event.v1.schema.json",
  "title": "Praxis expectation.registered payload v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "materialClassification",
    "expectationId",
    "subject",
    "expected",
    "verification",
    "createdAt",
    "evidence"
  ],
  "properties": {
    "materialClassification": { "const": "declared" },
    "expectationId": { "type": "string", "minLength": 1 },
    "subject": { "$ref": "#/$defs/subject" },
    "expected": { "$ref": "#/$defs/jsonValue" },
    "verification": { "enum": ["exact", "predicate", "external"] },
    "predicateId": { "type": "string", "minLength": 1 },
    "createdAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "validUntil": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/evidence" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "verification": { "const": "predicate" } } },
      "then": { "required": ["predicateId"] }
    }
  ],
  "$defs": {
    "jsonValue": {
      "anyOf": [
        { "type": "null" },
        { "type": "string" },
        { "type": "number" },
        { "type": "boolean" },
        { "type": "array", "items": { "$ref": "#/$defs/jsonValue" } },
        {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/jsonValue" }
        }
      ]
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "id": { "type": "string", "minLength": 1 }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin"],
      "anyOf": [
        { "required": ["eventId"] },
        { "required": ["assetId"] },
        { "required": ["artifactHash"] }
      ],
      "properties": {
        "eventId": { "type": "string", "minLength": 1 },
        "assetId": { "type": "string", "minLength": 1 },
        "artifactHash": { "type": "string", "minLength": 1 },
        "origin": {
          "enum": ["direct", "declared", "inferred", "institutional"]
        },
        "exposureInfluenced": { "type": "boolean" }
      }
    }
  }
}
