{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://praxis-runtime.local/schemas/reflection-proposed-event.v1.schema.json",
  "title": "Praxis reflection.proposed payload v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "materialClassification",
    "residualId",
    "decision",
    "reasons",
    "hypotheses",
    "recommendedActions",
    "budget",
    "budgetUsed",
    "evidenceDelta"
  ],
  "properties": {
    "materialClassification": { "const": "inferred" },
    "residualId": { "type": "string", "minLength": 1 },
    "decision": { "enum": ["STOP", "CONTINUE", "ESCALATE"] },
    "reasons": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "hypotheses": {
      "type": "array",
      "items": { "$ref": "#/$defs/hypothesis" }
    },
    "recommendedActions": {
      "type": "array",
      "items": { "$ref": "#/$defs/action" }
    },
    "budget": { "$ref": "#/$defs/budget" },
    "budgetUsed": { "$ref": "#/$defs/budgetUsage" },
    "evidenceDelta": { "$ref": "#/$defs/evidenceDelta" }
  },
  "allOf": [
    {
      "if": { "properties": { "decision": { "const": "STOP" } } },
      "then": {
        "properties": {
          "hypotheses": { "maxItems": 0 },
          "recommendedActions": { "maxItems": 0 }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision": { "enum": ["CONTINUE", "ESCALATE"] }
        }
      },
      "then": {
        "properties": {
          "hypotheses": { "minItems": 1 },
          "budgetUsed": {
            "properties": { "depth": { "minimum": 1 } }
          }
        }
      }
    }
  ],
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin"],
      "anyOf": [
        { "required": ["eventId"] },
        { "required": ["assetId"] },
        { "required": ["artifactHash"] }
      ],
      "properties": {
        "eventId": { "type": "string", "minLength": 1 },
        "assetId": { "type": "string", "minLength": 1 },
        "artifactHash": { "type": "string", "minLength": 1 },
        "origin": {
          "enum": ["direct", "declared", "inferred", "institutional"]
        },
        "exposureInfluenced": { "type": "boolean" }
      }
    },
    "hypothesis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "statement",
        "support",
        "counterevidence",
        "testability",
        "estimatedCost"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "statement": { "type": "string", "minLength": 1 },
        "support": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidence" }
        },
        "counterevidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence" }
        },
        "testability": { "type": "string", "minLength": 1 },
        "estimatedCost": { "type": "number", "minimum": 0 }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "requiredPermission", "parameters"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": [
            "collect-evidence",
            "verify-external",
            "request-human-confirmation"
          ]
        },
        "requiredPermission": {
          "enum": ["none", "external-verifier", "human-confirmation"]
        },
        "parameters": { "type": "object", "additionalProperties": true }
      },
      "allOf": [
        {
          "if": {
            "properties": { "kind": { "const": "collect-evidence" } }
          },
          "then": {
            "properties": { "requiredPermission": { "const": "none" } }
          }
        },
        {
          "if": {
            "properties": { "kind": { "const": "verify-external" } }
          },
          "then": {
            "properties": {
              "requiredPermission": { "const": "external-verifier" }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": { "const": "request-human-confirmation" }
            }
          },
          "then": {
            "properties": {
              "requiredPermission": { "const": "human-confirmation" }
            }
          }
        }
      ]
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxDepth", "maxHypotheses", "maxToolCalls", "maxElapsedMs"],
      "properties": {
        "maxDepth": { "type": "integer", "minimum": 0 },
        "maxHypotheses": { "type": "integer", "minimum": 0 },
        "maxToolCalls": { "type": "integer", "minimum": 0 },
        "maxElapsedMs": { "type": "integer", "minimum": 0 }
      }
    },
    "budgetUsage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["depth", "hypotheses", "toolCalls", "elapsedMs"],
      "properties": {
        "depth": { "type": "integer", "minimum": 0 },
        "hypotheses": { "type": "integer", "minimum": 0 },
        "toolCalls": { "type": "integer", "minimum": 0 },
        "elapsedMs": { "type": "integer", "minimum": 0 }
      }
    },
    "evidenceDelta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fromSeq", "toSeq", "evidence"],
      "properties": {
        "fromSeq": { "type": "integer", "minimum": 0 },
        "toSeq": { "type": "integer", "minimum": 0 },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence" }
        }
      }
    }
  }
}
