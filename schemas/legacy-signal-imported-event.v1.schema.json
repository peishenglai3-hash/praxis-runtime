{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://praxis-runtime.local/schemas/legacy-signal-imported-event.v1.schema.json",
  "title": "Praxis legacy.signal.imported payload v1",
  "description": "An imported first-generation signal record. The material is declared by the source, carries the digest of the corpus it was read from, and lists the declared fields the source never persisted so a reader cannot mistake an absent value for a recorded one.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "materialClassification",
    "sourceFingerprint",
    "sourcePath",
    "recordId",
    "signalKind",
    "category",
    "value",
    "declaredTimestamp",
    "confidence",
    "source",
    "declaredFields",
    "absentFields"
  ],
  "properties": {
    "materialClassification": { "const": "declared" },
    "sourceFingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sourcePath": { "type": "string", "minLength": 1 },
    "recordId": { "type": "string", "minLength": 1 },
    "signalKind": { "type": "string", "minLength": 1 },
    "category": { "type": "string", "minLength": 1 },
    "value": { "type": "string" },
    "declaredTimestamp": { "type": "string" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "source": { "type": "string", "minLength": 1 },
    "declaredFields": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "absentFields": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
