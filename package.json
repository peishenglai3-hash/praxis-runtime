{
  "name": "praxis-runtime",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first runtime for auditable long-term human-AI collaboration.",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.13.0 <23",
    "pnpm": "11.19.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "test": "vitest run",
    "typecheck": "tsc --build tsconfig.build.json --pretty false && tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "boundaries": "dependency-cruiser --config .dependency-cruiser.cjs packages apps",
    "boundaries:fixture": "node scripts/assert-cycle-detected.mjs",
    "boundaries:negative-fixture": "node scripts/assert-boundaries-detected.mjs",
    "workspace:deps": "node scripts/assert-workspace-deps.mjs",
    "phase1:concurrency": "node scripts/phase1-concurrency.mjs",
    "phase1:crash": "node scripts/phase1-crash-recovery.mjs",
    "phase1:throughput": "node scripts/phase1-throughput.mjs",
    "phase2:scenario": "node scripts/phase2-replay-context.mjs",
    "phase3:schemas": "node scripts/assert-phase3-schemas.mjs",
    "phase3:scenario": "node scripts/phase3-residual-reflection.mjs",
    "phase35:scenario": "node scripts/phase35-maintenance.mjs",
    "phase4:scenario": "node scripts/phase4-assets.mjs",
    "phase5:schemas": "node scripts/assert-phase5-schemas.mjs",
    "phase5:scenario": "node scripts/phase5-legacy.mjs",
    "fixture:legacy": "node scripts/generate-legacy-fixture.mjs",
    "verify": "pnpm format:check && pnpm lint && pnpm workspace:deps && pnpm boundaries && pnpm boundaries:fixture && pnpm boundaries:negative-fixture && pnpm typecheck && pnpm test && pnpm build && pnpm phase3:schemas && pnpm phase5:schemas && pnpm phase1:concurrency && pnpm phase1:crash && pnpm phase1:throughput && pnpm phase2:scenario && pnpm phase3:scenario && pnpm phase35:scenario && pnpm phase4:scenario && pnpm phase5:scenario && pnpm phase5:cli",
    "phase5:cli": "node scripts/phase5-cli.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/node": "^22.15.0",
    "dependency-cruiser": "^16.10.4",
    "eslint": "^9.35.0",
    "prettier": "^3.6.2",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vitest": "^3.2.4"
  }
}
